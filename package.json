{
  "name": "clipcaptionai",
  "version": "0.2.1",
  "description": "CLI-first local AI video editor and model harness for planning, rendering, captioning, and QA of production video assets.",
  "author": {
    "name": "Jonathan Gan",
    "url": "https://github.com/jongan69"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "main": "desktop/main.mjs",
  "bin": {
    "clipcaptionai": "./bin/clipcaptionai.js",
    "cca": "./bin/clipcaptionai.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongan69/ClipCaptionAI.git"
  },
  "bugs": {
    "url": "https://github.com/jongan69/ClipCaptionAI/issues"
  },
  "homepage": "https://github.com/jongan69/ClipCaptionAI#readme",
  "keywords": [
    "ai-video-editor",
    "youtube-shorts",
    "remotion",
    "captions",
    "broll",
    "clipper",
    "creator-tools",
    "whisper",
    "tiktok",
    "reels"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".env.example",
    "assets/icon.png",
    "assets/icon.svg",
    "bin/",
    "caption-style.json",
    "CHANGELOG.md",
    "docs/AGENT_GUIDE.md",
    "docs/AI_PROVIDERS.md",
    "docs/ASSET_RECOVERY.md",
    "docs/TOOL_ADAPTERS.md",
    "docs/VOICE_LIBRARY.md",
    "docs/MARKETING_PLATFORM.md",
    "docs/PREPAI_PERFORMANCE_CREATIVE_CONCEPTS.md",
    "docs/PRODUCTION_SUPPORT.md",
    "docs/RELEASE.md",
    "docs/WORKFLOWS.md",
    "desktop/worker/progress.mjs",
    "examples/",
    "remotion.config.ts",
    "scripts/*.mjs",
    "scripts/*.mts",
    "scripts/adapters/",
    "scripts/platform/",
    "scripts/marketing/",
    "scripts/ebay/",
    "scripts/logo/",
    "assets/logos/",
    "src/",
    "templates/rotato/",
    "styles/",
    "tsconfig.json"
  ],
  "scripts": {
    "menu": "bun scripts/clipkit.mjs",
    "clipkit": "bun scripts/clipkit.mjs",
    "doctor": "bun scripts/clipkit.mjs doctor",
    "rotato": "bun scripts/rotato-cli.mjs",
    "test": "bun test --timeout 120000",
    "check": "bun run typecheck && bun run typecheck:desktop && bun run lint && bun run test",
    "lint": "bunx eslint scripts/ desktop/ tests/",
    "format": "bunx prettier --write \"scripts/**/*.mjs\" \"desktop/**/*.{mjs,cjs,js,ts,tsx}\" \"tests/**/*.mjs\"",
    "format:check": "bunx prettier --check \"scripts/**/*.mjs\" \"desktop/**/*.{mjs,cjs,js,ts,tsx}\" \"tests/**/*.mjs\"",
    "cleanup": "bun scripts/cleanup.mjs",
    "studio": "bunx remotion studio src/index.tsx",
    "logo:vectorize": "bun scripts/logo/vectorize.mjs",
    "logo:spec": "bun scripts/logo/build-spec.mjs",
    "logo:verify": "bunx tsx scripts/logo/verify-variant.tsx",
    "logo:render": "bun scripts/logo/render-all.mjs",
    "render:clip": "bun scripts/render-clip.mjs",
    "portrait:analyze": "bun scripts/portrait-framing.mjs",
    "render:batch": "bun scripts/render-batch.mjs",
    "rerender:clip": "bun scripts/rerender-clip.mjs",
    "smart:clips": "bun scripts/smart-clips.mjs",
    "moments:review": "bun scripts/review-moments.mjs",
    "download:youtube": "bun scripts/download-youtube.mjs",
    "frame:links": "bun scripts/render-frame-from-links.mjs",
    "ebay:cinematic-ads": "bun scripts/ebay/ebay-cinematic-ads.mjs",
    "ebay:traffic-optimize": "bun scripts/ebay/optimize-ebay-traffic-report.mjs",
    "ebay:creative-intel": "bun scripts/ebay/competitive-listing-video-architect.mjs",
    "ebay:render-blueprint-ad": "bun scripts/ebay/render-competitive-blueprint-ad.mjs",
    "ebay:render-blueprint-batch": "bun scripts/ebay/render-competitive-blueprint-batch.mjs",
    "ebay:prep-premium-renders": "bun scripts/ebay/prepare-competitive-premium-renders.mjs",
    "ebay:collect-premium-renders": "bun scripts/ebay/collect-competitive-premium-renders.mjs",
    "ebay:finalize-premium-ads": "bun scripts/ebay/finalize-competitive-premium-ads.mjs",
    "ebay:competitive-status": "bun scripts/ebay/audit-competitive-video-pipeline.mjs",
    "ebay:competitive-review": "bun scripts/ebay/build-competitive-review-board.mjs",
    "ebay:competitive-qa": "bun scripts/ebay/qa-competitive-videos.mjs",
    "ebay:competitive-loop": "bun scripts/ebay/run-competitive-video-control-loop.mjs",
    "ebay:competitive-handoff": "bun scripts/ebay/export-competitive-render-handoff.mjs",
    "ebay:competitive-higgsfield-render": "bun scripts/ebay/run-competitive-higgsfield-renders.mjs",
    "ebay:competitive-packets": "bun scripts/ebay/export-competitive-creative-packets.mjs",
    "ebay:voiceover-plan": "bun scripts/ebay/export-competitive-voiceover-plan.mjs",
    "ebay:main-photo-candidates": "bun scripts/ebay/generate-ebay-main-photo-candidates.mjs",
    "ebay:main-photo-apply-bundle": "bun scripts/ebay/export-ebay-main-photo-apply-bundle.mjs",
    "ebay:competitive-research-rerun": "bun scripts/ebay/rerun-competitive-research-packet.mjs",
    "ebay:competitive-research-queue": "bun scripts/ebay/export-competitive-research-queue.mjs",
    "ebay:competitive-research-import": "bun scripts/ebay/import-competitive-research-results.mjs",
    "ebay:competitive-research-loop": "bun scripts/ebay/run-competitive-research-import-loop.mjs",
    "ebay:competitive-research-process": "bun scripts/ebay/process-competitive-research-queue.mjs",
    "download:split": "bun scripts/download-and-split.mjs",
    "video:split": "bun scripts/split-local-video.mjs",
    "clip:auto": "bun scripts/process-links.mjs",
    "clips:fixed": "bun scripts/clipkit.mjs fixed-clips",
    "broll:captions": "bun scripts/clipkit.mjs broll-captions",
    "moments:auto": "bun scripts/clipkit.mjs moments",
    "caption:auto": "bun scripts/caption-video.mjs",
    "chapter:auto": "bun scripts/chapter-video.mjs",
    "tighten:auto": "bun scripts/tighten-video.mjs",
    "compress:video": "bun scripts/compress-video.mjs",
    "video:enhance": "bun scripts/enhance-video-with-broll.mjs",
    "output:open": "bun scripts/clipkit.mjs open-latest",
    "scene:mix": "bun scripts/assemble-context-scenes.mjs",
    "scene:index": "bun scripts/index-scene-library.mjs",
    "scene:ingest:youtube-cc": "bun scripts/ingest-youtube-cc-scenes.mjs",
    "scene:blacklist": "bun scripts/sync-scene-blacklist.mjs",
    "broll:find": "bun scripts/find-broll-from-text.mjs",
    "scene:research-pop-culture": "bun scripts/research-pop-culture-scenes.mjs",
    "sfx:standardize": "bun scripts/standardize-sfx-library.mjs",
    "sfx:mix": "bun scripts/mix-sfx.mjs",
    "broll:enhance": "bun scripts/enhance-video-with-broll.mjs",
    "process": "bun scripts/process-links.mjs",
    "transcribe": "bun scripts/transcribe-openai.mjs",
    "transcribe:benchmark": "bun scripts/benchmark-transcription.mjs",
    "sample:props": "bun scripts/make-sample-props.mjs",
    "video": "bun scripts/video.mjs",
    "voiceover:elevenlabs": "bun scripts/generate-elevenlabs-voiceover.mjs",
    "voiceover:library": "bun scripts/generate-elevenlabs-library.mjs",
    "fal:image-edit": "bun scripts/fal-image-edit.mjs",
    "fal:reference-video": "bun scripts/fal-reference-video.mjs",
    "interview:qa": "bun scripts/interview-qa.mjs",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:desktop": "bunx tsc -p desktop/tsconfig.json",
    "desktop:env-check": "bun desktop/check-environment.mjs",
    "desktop:env-check:json": "bun desktop/check-environment.mjs --json",
    "desktop:build": "bunx vite build --config desktop/vite.config.ts && bun desktop/lib/fix-crossorigin.mjs",
    "desktop": "bun desktop/check-environment.mjs && bunx electron ./desktop/main.mjs",
    "desktop:dev": "CCA_DESKTOP_DEV=1 bun desktop/check-environment.mjs && bunx electron ./desktop/main.mjs",
    "desktop:dev:ui": "bunx vite build --watch --config desktop/vite.config.ts",
    "desktop:package": "bun run desktop:build && bun desktop/check-environment.mjs && bunx electron-builder --publish never",
    "desktop:package:mac": "bun run desktop:build && bun desktop/check-environment.mjs && bunx electron-builder --mac --publish never",
    "desktop:package:win": "bun run desktop:build && bun desktop/check-environment.mjs && bunx electron-builder --win --publish never",
    "desktop:package:linux": "bun run desktop:build && bun desktop/check-environment.mjs && bunx electron-builder --linux --publish never",
    "desktop:package:all": "bun run desktop:package:mac && bun run desktop:package:win && bun run desktop:package:linux"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@fal-ai/client": "^1.10.1",
    "@remotion/captions": "4.0.481",
    "@remotion/cli": "4.0.481",
    "@remotion/openai-whisper": "4.0.481",
    "commander": "^15.1.0",
    "dotenv": "16.4.7",
    "ip-address": "^10.7.6",
    "js-yaml": "^4.3.2",
    "openai": "6.49.0",
    "picocolors": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "remotion": "4.0.481",
    "tsx": "4.20.3",
    "zod": "4.6.6",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "24.0.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^43.8.8",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.3.5",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "com.clipcaptionai.desktop",
    "productName": "ClipCaptionAI",
    "copyright": "Copyright \u00a9 2026",
    "artifactName": "ClipCaptionAI-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "scripts/**/*",
      "bin/**/*",
      "src/**/*",
      "styles/**/*",
      "templates/rotato/**/*",
      "caption-style.json",
      "package.json",
      "examples/**/*",
      "assets/logos/**/*",
      "remotion.config.ts",
      "tsconfig.json"
    ],
    "extraFiles": [
      {
        "from": ".env.example",
        "to": ".env.example"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/**/*",
      "bin/**/*",
      "scripts/**/*",
      "src/**/*",
      "styles/**/*",
      "templates/rotato/**/*",
      "public/**/*",
      "scene-library/**/*",
      "custom-scenes-library/**/*",
      "sfx-library/**/*",
      "music-library/**/*",
      "models/**/*",
      "caption-style.json",
      "remotion.config.ts",
      "tsconfig.json",
      "package.json",
      "examples/**/*",
      "assets/logos/**/*"
    ],
    "afterSign": "desktop/scripts/notarize.cjs",
    "mac": {
      "category": "public.app-category.video",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "target": "dmg"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "overrides": {
    "zod": "4.6.6",
    "browserslist": "4.28.7",
    "nanoid": "3.3.20",
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6",
    "baseline-browser-mapping": "2.11.0",
    "fast-uri": "3.1.9",
    "js-yaml": "4.3.2",
    "@xmldom/xmldom": "0.8.15",
    "undici": "7.30.2",
    "minimatch@>=7": "11.0.8",
    "brace-expansion@>=4": "5.0.13",
    "brace-expansion@<2": "1.1.21",
    "brace-expansion@>=2 <4": "2.1.7"
  }
}
